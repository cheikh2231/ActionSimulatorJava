@startuml
Enum ActionType {
    Avancer
    Gauche
    Droite
    Lever
    Abaisser
}

Abstract Class Action {
    ActionType
    Cursor c

   - type
   - details : int
}

Class ActionAvancer {
    Default details = 30
    - Type pixels

    c.Move(details);
}

Class ActionTourner{

    Default details = 90
    - Type degre
    -TURN_LEFT(-cursor.setRotate(details))
    -TURN_RIGHT(cursor.setRotate(details))
}


Class Stylo {
   Color: Color
   Width: double
   LineStyle : Solid
}

Class Point{
Double:X
Double:Y
Move(int) :
}

Class Cursor{

   Move(details) (dx=Math.cos(angle) * distance;
   dy = Math.sin(angle) * distance);

   Position:Point
   angle :
}

Class Programme{
    List<Action> actionList;
}

Class Ligne {
    Point depart
    Point fin
}

Class SceneModel {
   List<Ligne> lignes;
}



ActionAvancer --|> Action
ActionTourner --|> Action
Action --> ActionType : type
Programme "1" --> "0..*" Action : contient
Cursor "1" --> "1" Point : contient
Programme "1" --> "1" Stylo : contient


@enduml