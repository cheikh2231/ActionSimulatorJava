@startuml

abstract class Action {
    - name
    - measure
    + copy()
    + executeAction()
    + isValidMeasure()
    + getValue()
}

class ActionMoveForward
class ActionTurn <<abstract>>
class ActionTurnLeft
class ActionTurnRight
class ActionPen {
    - penDown
    + switchPenStatus()
}
enum ActionType {
    ACTIONMOVEFORWARD
    ACTIONPEN
    ACTIONTURNLEFT
    ACTIONTURNRIGHT
    VARIABLEDECLARATION
    VARIABLEASSIGNATION
    VARIABLEINCRDECR
    REPEAT
    ENDREPEAT
}

class ActionRepeat {
    - nbRepetitions
}
class ActionEndRepeat

abstract class Variable {
    + {static} variableMap
}
class VariableDeclaration {
    - nom
    - valeurInitiale
}
class VariableAssignation {
    - nom
    - valeur
}
class VariableIncrDecr {
    - nom
    - delta
}

class Program {
    - actions
    + addAction()
    + removeAction()
    + up() / down()
    + hasAnomalies()
}

class SceneActions {
    - lines
    - cursor
    + moveForward()
    + turn()
    + switchPenStatus()
    + executeAction()
}

class Cursor {
    - position
    - angle
    + moveForward()
    + turn()
}

class Line {
    - start
    - end
}

class Point {
    - x
    - y
}
class Actions {
    - {static} actions : List<Action>
    + {static} getActions() : List<Action>
    + {static} getAction(idx) : Action
}

'Les héritages
Action <|-- ActionMoveForward
Action <|-- ActionTurn
Action <|-- ActionPen
Action <|-- ActionRepeat
Action <|-- ActionEndRepeat
Action <|-- Variable

ActionTurn <|-- ActionTurnLeft
ActionTurn <|-- ActionTurnRight

Variable <|-- VariableDeclaration
Variable <|-- VariableAssignation
Variable <|-- VariableIncrDecr
Action --> ActionType : getActionType()

'LEs associations avec metiers
Program --> Action       : contient
SceneActions --> Cursor  : pilote
SceneActions --> Line    : dessine
Cursor --> Point         : position
Line --> Point           : debutDessin / finDessin
Actions --> Action : catalogue de
@enduml
